<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <Version>0.4.0</Version>
    <AssemblyVersion>0.4.0.0</AssemblyVersion>
    <FileVersion>0.4.0.0</FileVersion>
    <InformationalVersion>0.4.0</InformationalVersion>
    <Product>TSD Support Agent</Product>
    <Description>TSD Support Agent installer</Description>
    <Authors>TSD Support Agent contributors</Authors>
    <Company>TSD Support Agent contributors</Company>
    <Copyright>Copyright 2026 TSD Support Agent contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/frmsgyn-rgb/tsd-support-agent</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>TSD-Support-Setup</AssemblyName>
    <EmbeddedAgentPath Condition="'$(EmbeddedAgentPath)' == ''">../TsdSupportAgent/publish/TsdSupportAgent.exe</EmbeddedAgentPath>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(EmbeddedAgentPath)" LogicalName="TsdSupportAgent.exe" />
    <PackageReference Include="System.IO.FileSystem.AccessControl" Version="5.0.0" />
  </ItemGroup>
</Project>
